{
	"name": "RandomSelectionFork",
	"version": "2.5.0",
	"author": [
		"Ross McClure",
		"Jack Phoenix",
		"..."
	],
	"license-name": "GPL-2.0-or-later",
	"url": "https://github.com/Tech-TTGames/mediawiki-extensions-RandomSelection",
	"descriptionmsg": "randomselection-desc",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"MessagesDirs": {
		"RandomSelection": [
			"i18n"
		]
	},
	"AutoloadClasses": {
		"RandomSelection": "src/RandomSelection.php"
	},
	"ExtensionMessagesFiles": {
		"RandomSelectionMagic": "RandomSelection.i18n.magic.php"
	},
	"Hooks": {
		"ParserFirstCallInit": "RandomSelection::register",
		"GetMagicVariableIDs": "RandomSelection::variableIds"
	},
	"config": {
		"RandomSelectionAllowUncached": {
			"value": true,
			"description": "Whether the 'uncached' attribute should be enabled"
		}
	},
	"manifest_version": 2
}
